@startuml logger
' === Clean modern look ===
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2563EB
skinparam roundCorner 15
skinparam shadowing false

' Hide empty members
hide empty members

' Hide circle
hide circle

' Remove circles
skinparam CircledCharacterRadius 10

' Remove markers from parameters and methods
skinparam classAttributeIconSize 0

' ===== Diagram content =====
class ILogger {
    **  abstract**
    --
    + ** initialize(**model: Module, optimizer: Optimizer**)**: None
    + ** train_start()**: None
    + ** epoch_end(**losses: Losses, metrics: Mapping[str, List[float]]**)**: None
    + ** exception(**error: BaseException**)**: None
    + ** train_end(**stopped: bool**)**: None
    + ** save(**file: str**)**: None
}

@enduml
