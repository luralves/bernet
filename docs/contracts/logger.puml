@startuml logger
' === Clean modern look ===
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2563EB
skinparam roundCorner 15
skinparam shadowing false

' Hide empty members
hide empty members

' Hide circle
hide circle

' Remove circles
skinparam CircledCharacterRadius 10

' Remove markers from parameters and methods
skinparam classAttributeIconSize 0

' ===== Diagram content =====
class ILogger {
    **  abstract**
    --
    + ** initialize(**&#42;args, &#42;&#42;kargs**)**: None
    + ** train_start(**&#42;args, &#42;&#42;kargs**)**: None
    + ** epoch_end(**&#42;args, &#42;&#42;kargs**)**: None
    + ** exception(**&#42;args, &#42;&#42;kargs**)**: None
    + ** train_end(**&#42;args, &#42;&#42;kargs**)**: None
    + ** save(**file: str**)**: None
}

@enduml
