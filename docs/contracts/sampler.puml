@startuml sampler
' === Clean modern look ===
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2563EB
skinparam roundCorner 15
skinparam shadowing false

' Hide empty members
hide empty members

' Hide circle
hide circle

' Remove circles
skinparam CircledCharacterRadius 10

' Remove markers from parameters and methods
skinparam classAttributeIconSize 0

' ===== Diagram content =====
class Batch {
    **  NamedTuple**
    --
    - ** residual**: TensorData
    - ** boundary**: TensorData
    - ** initial**: TensorData
    - ** observational**: TensorData
}

class ISampler {
    **  abstract**
    --
    + ** generate()**: int
    + ** batch(**index: int**)**: Batch
    + ** test()**: TensorData
    + ** validation()**: TensorData
}

' Relationships
ISampler <-- Batch

@enduml
