@startuml sampler
' === Clean modern look ===
skinparam backgroundColor #FFFFFF
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #2563EB
skinparam roundCorner 15
skinparam shadowing false

' Hide empty members
hide empty members

' Hide circle
hide circle

' Remove circles
skinparam CircledCharacterRadius 10

' Remove markers from parameters and methods
skinparam classAttributeIconSize 0

' ===== Diagram content =====
class Batch {
    **  dataclass**
    --
    - ** residual**: Mapping[str, Tensor]
    - ** boundary**: Mapping[str, Tensor]
    - ** initial**: Mapping[str, Tensor]
    - ** observational**: Mapping[str, Tensor]
}

class ISampler {
    **  abstract**
    --
    + ** batch(**index: int**)**: Batch
    + ** metrics()**: Mapping[str, Tensor]
    + ** generate()**: int
}

' Relationships
ISampler <-- Batch

@enduml
